{{-- Full source preamble, collapsed by default — the metadata that isn't surfaced elsewhere. --}}
@if(Object.keys(document.preambleData).length)
  <details class="bip-preamble">
    <summary>
      <span class="bip-preamble__chevron">
        @svg('lucide:chevron-right', { width: 16, height: 16 })
      </span>
      @svg('lucide:file-text', { width: 15, height: 15 })
      Preamble
    </summary>
    <dl class="bip-preamble__dl">
      @each((value, key) in document.preambleData)
        <dt>{{ key }}</dt>
        <dd>{{ Array.isArray(value) ? value.join(', ') : value }}</dd>
      @end
    </dl>
  </details>
@end
