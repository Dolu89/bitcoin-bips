{{-- Full source preamble, collapsed by default — the metadata that isn't surfaced elsewhere.
     The adapter sets `view.preamble.show` to false for projects whose preamble is fully shown
     in the header (e.g. NIPs), leaving this section redundant. --}}
@if(view.preamble.show && view.preamble.rows.length)
  <details class="bip-preamble">
    <summary>
      <span class="bip-preamble__chevron">
        @svg('lucide:chevron-right', { width: 16, height: 16 })
      </span>
      @svg('lucide:file-text', { width: 15, height: 15 })
      Preamble
    </summary>
    <dl class="bip-preamble__dl">
      @each(row in view.preamble.rows)
        <dt>{{ row.label }}</dt>
        <dd>{{ row.value }}</dd>
      @end
    </dl>
  </details>
@end
