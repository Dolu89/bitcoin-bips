# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App — generate APP_KEY with `node ace generate:key`. APP_URL is the public origin.
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Projects — optional per-project domain overrides (defaults in config/projects.ts).
# BIPS_DOMAIN=bips.xyz
# NIPS_DOMAIN=nips.nostr.com

# GitHub — token for authenticated ingestion reads (node ace ingest:run). Keep secret; never commit.
GITHUB_API_KEY=

# Meilisearch — host + key. In Docker the host is the internal service URL.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# Analytics — optional Umami. Absent values render no tag.
# UMAMI_SCRIPT_URL=
# BIPS_ANALYTICS_ID=
# NIPS_ANALYTICS_ID=

# Queue (@adonisjs/queue) — adapter: 'database' (prod, persisted in SQLite) or 'sync' (dev/tests).
QUEUE_DRIVER=database

# Embedded sync scheduler — optional in-app recurring full sync, run from inside the app
# (no OS cron needed). Off by default; set true to enable. SYNC_INTERVAL is the cadence
# passed to the schedule's .every() (e.g. 6h, 30m, 1d).
# SYNC_SCHEDULER_ENABLED=false
# SYNC_INTERVAL=6h
