SESSION_DRIVER=memory

# Pin the host so request.hostname() is deterministic and current_project resolves bips
# under the test HTTP server (else /:number 404s). See spec-reading current_project middleware.
HOST=127.0.0.1
APP_URL=http://127.0.0.1:3333
BIPS_DOMAIN=127.0.0.1

# Isolated test database — the suite migrates + truncates this every run; never the dev db.sqlite3.
DB_DATABASE=test.sqlite3

# Ingestion source is faked in tests (FakeSpecSourceService) — no real token here.
GITHUB_API_KEY=
